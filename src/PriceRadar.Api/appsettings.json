{
  "ConnectionStrings": {
    "Sql": ""
  },
  "Security": {
    "ApiKey": ""
  },
  "RateLimiting": {
    "LookupPerMinute": 60,
    "IngestionPerMinute": 5
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Matching": {
    "AutoMatchThreshold": 0.90,
    "NewBookThreshold": 0.65,
    "MinMargin": 0.05,
    "MaxCandidates": 20
  },
  "Ai": {
    "Enabled": true,
    "Model": "claude-haiku-5-5",
    "Effort": "low",
    "MaxTokens": 1024,
    "PromptVersion": "v1",
    "MaxCallsPerRun": 200,
    "DailyBudgetUsd": 0.50,
    "PricePerMTokIn": 0.10,
    "PricePerMTokOut": 0.50,
    "TimeoutSeconds": 20,
    "BaseUrl": "https://api.anthropic.com/"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
