<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH s AS (&#xa;        SELECT CASE WHEN @Bucket = &apos;week&apos; THEN DATEADD(day, 1 - d.[DayOfWeek], d.[Date]) ELSE d.[Date] END AS Period,&#xa;               ps.PriceRsd&#xa;        FROM dw.PriceSnapshot AS ps&#xa;        JOIN dw.DimDate AS d ON d.DateKey = ps.DateKey&#xa;        WHERE ps.BookId = @BookId&#xa;          AND ps.DateKey BETWEEN @FromDateKey AND @ToDateKey&#xa;    )&#xa;    SELECT DISTINCT&#xa;        Period,&#xa;        MIN(PriceRsd) OVER (PARTITION BY Period) AS MinPrice,&#xa;        CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY PriceRsd) OVER (PARTITION BY Period) AS decimal(12,2)) AS MedianPrice,&#xa;        MAX(PriceRsd) OVER (PARTITION BY Period) AS MaxPrice,&#xa;        COUNT(*) OVER (PARTITION BY Period) AS Snapshots&#xa;    FROM s&#xa;    ORDER BY Period" StatementId="1" StatementCompId="10" StatementType="SELECT" StatementSqlHandle="0x090082EBE2B6F75E7944348086DA136391E20000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="466100701" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="1.14895" StatementEstRows="7619.71" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x51D27298D9C05E57" QueryPlanHash="0x075DFC197E840393" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="3152" CachedPlanSize="120" CompileTime="3" CompileCPU="3" CompileMemory="872"><MemoryGrantInfo SerialRequiredMemory="1024" SerialDesiredMemory="3152" RequiredMemory="1024" DesiredMemory="3152" RequestedMemory="3152" GrantWaitTime="0" MaxQueryMemory="153720" GrantedMemory="3152" MaxUsedMemory="1080" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="13986" EstimatedPagesCached="10489" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="20704"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-03T20:01:07.88" ModificationCount="0" SamplingPercent="100" Statistics="[IX_PriceSnapshot_Book_Date]" Table="[PriceSnapshot]" Schema="[dw]" Database="[PriceRadar]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-10-28T21:06:35.56" ModificationCount="0" SamplingPercent="100" Statistics="[PK_DimDate]" Table="[DimDate]" Schema="[dw]" Database="[PriceRadar]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-03T19:46:00.96" ModificationCount="37" SamplingPercent="27.4615" Statistics="[_WA_Sys_00000006_5DCAEF64]" Table="[PriceSnapshot]" Schema="[dw]" Database="[PriceRadar]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-03T19:46:00.34" ModificationCount="37" SamplingPercent="27.4615" Statistics="[UX_PriceSnapshot_Listing_Run]" Table="[PriceSnapshot]" Schema="[dw]" Database="[PriceRadar]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-03T19:46:00.47" ModificationCount="37" SamplingPercent="27.4615" Statistics="[PK_PriceSnapshot]" Table="[PriceSnapshot]" Schema="[dw]" Database="[PriceRadar]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-03T19:46:00.40" ModificationCount="37" SamplingPercent="27.4615" Statistics="[_WA_Sys_00000005_5DCAEF64]" Table="[PriceSnapshot]" Schema="[dw]" Database="[PriceRadar]"></StatisticsInfo></OptimizerStatsUsage><QueryTimeStats ElapsedTime="42" CpuTime="42"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Sort" LogicalOp="Distinct Sort" EstimateRows="7619.71" EstimateIO="0.0112613" EstimateCPU="0.305668" AvgRowSize="41" EstimatedTotalSubtreeCost="1.14895" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><Ou