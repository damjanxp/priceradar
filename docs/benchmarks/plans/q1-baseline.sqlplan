<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH latest AS (&#xa;        SELECT ps.PriceRsd,&#xa;               ROW_NUMBER() OVER (PARTITION BY ps.ListingId ORDER BY ps.CapturedAtUtc DESC, ps.PriceSnapshotId DESC) AS rn&#xa;        FROM dw.PriceSnapshot AS ps&#xa;        WHERE ps.BookId = @BookId&#xa;          AND ps.DateKey BETWEEN @fromKey AND @toKey&#xa;          AND ps.CapturedAtUtc &gt; @from&#xa;          AND ps.CapturedAtUtc &lt;= @now&#xa;    )&#xa;    SELECT TOP (1)&#xa;        COUNT(*)      OVER () AS SampleSize,&#xa;        MIN(PriceRsd) OVER () AS MinPrice,&#xa;        MAX(PriceRsd) OVER () AS MaxPrice,&#xa;        CAST(PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY PriceRsd) OVER () AS decimal(12,2)) AS P25,&#xa;        CAST(PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY PriceRsd) OVER () AS decimal(12,2)) AS Median,&#xa;        CAST(PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY PriceRsd) OVER () AS decimal(12,2)) AS P75&#xa;    FROM latest&#xa;    WHERE rn = 1" StatementId="1" StatementCompId="13" StatementType="SELECT" StatementSqlHandle="0x090001D94CD36DF810ABEC30B02026DBD8CE0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="450100644" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.88898" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x71DFFF2273C767DA" QueryPlanHash="0x132F000747C74922" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="12" MemoryGrant="12096" CachedPlanSize="240" CompileTime="126" CompileCPU="78" CompileMemory="1472"><ThreadStat Branches="2" UsedThreads="24"><Thr