<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH s AS (&#xa;        SELECT CASE WHEN @Bucket = &apos;week&apos; THEN DATEADD(day, 1 - d.[DayOfWeek], d.[Date]) ELSE d.[Date] END AS Period,&#xa;               ps.PriceRsd&#xa;        FROM dw.PriceSnapshot AS ps&#xa;        JOIN dw.DimDate AS d ON d.DateKey = ps.DateKey&#xa;        WHERE ps.BookId = @BookId&#xa;          AND ps.DateKey BETWEEN @FromDateKey AND @ToDateKey&#xa;    )&#xa;    SELECT DISTINCT&#xa;        Period,&#xa;        MIN(PriceRsd) OVER (PARTITION BY Period) AS MinPrice,&#xa;        CAST(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY PriceRsd) OVER (PARTITION BY Period) AS decimal(12,2)) AS MedianPrice,&#xa;        MAX(PriceRsd) OVER (PARTITION BY Period) AS MaxPrice,&#xa;        COUNT(*) OVER (PARTITION BY Period) AS Snapshots&#xa;    FROM s&#xa;    ORDER BY Period" StatementId="1" StatementCompId="10" StatementType="SELECT" StatementSqlHandle="0x090082EBE2B6F75E7944348086DA136391E20000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="466100701" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.92221" StatementEstRows="7687.51" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x51D27298D9C05E57" QueryPlanHash="0xF17090BF28151298" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="12" MemoryGrant="35520" CachedPlanSize="160" CompileTime="4" CompileCPU="4" CompileMemory="952"><ThreadStat Branches="3" UsedThreads="36"><ThreadReservation NodeId="0" ReservedThreads="36"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="89.2122"><MissingInd