digraph er {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.25, ranksep=0.7, pad=0.15, bgcolor="white", splines=true];
  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [color="#5b6b7f", arrowhead=crow, arrowtail=tee, dir=both, arrowsize=0.7];
  ingest_Source [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#3a6ea5" ALIGN="LEFT"><FONT COLOR="white"><B>ingest.Source</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">SourceId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#998855" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">Code</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Kind</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">BaseUrl</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">IsEnabled</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bit</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">MinDelayMs</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR></TABLE>>];
  ingest_ScrapeRun [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#3a6ea5" ALIGN="LEFT"><FONT COLOR="white"><B>ingest.ScrapeRun</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">ScrapeRunId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">SourceId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ScopeKey</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Status / Stage</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">IsComplete</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bit</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#998855" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">IdempotencyKey</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">uniqueidentifier</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Listings* / AiCalls</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">EurRsdRate</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">decimal(9,4)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Created/Started/FinishedAtUtc</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">datetime2(3)</FONT></TD></TR></TABLE>>];
  ingest_StagingListing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#3a6ea5" ALIGN="LEFT"><FONT COLOR="white"><B>ingest.StagingListing</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">StagingListingId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">ScrapeRunId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ExternalId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">RawTitle / RawAuthor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">nvarchar</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">RawPrice / RawCondition</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">nvarchar</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">PriceRsd</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">decimal(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">NormTitle / NormAuthor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">BookId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">MatchStatus / MatchScore</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ProcessStatus</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">PayloadHash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">binary(32)</FONT></TD></TR></TABLE>>];
  dw_Book [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#4a8a3a" ALIGN="LEFT"><FONT COLOR="white"><B>dw.Book</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">BookId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Title</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">nvarchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Author</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">nvarchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">NormTitle</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">NormAuthor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#998855" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">NormKey (computed)</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(501)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Origin</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">NeedsReview</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bit</FONT></TD></TR></TABLE>>];
  dw_Listing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#4a8a3a" ALIGN="LEFT"><FONT COLOR="white"><B>dw.Listing</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">ListingId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">SourceId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#998855" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">ExternalId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">BookId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">MatchStatus / MatchScore</TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ScopeKey</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">CurrentPriceRsd</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">decimal(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">First/LastSeenAtUtc</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">datetime2(3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">LastSeenRunId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">MissedRunCount</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">DisappearedAtUtc</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">datetime2(3)</FONT></TD></TR></TABLE>>];
  dw_PriceSnapshot [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#2f6d22" ALIGN="LEFT"><FONT COLOR="white"><B>dw.PriceSnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">PriceSnapshotId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">ListingId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">BookId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">SourceId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">ScrapeRunId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">DateKey</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">PriceRsd</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">decimal(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">CapturedAtUtc</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">datetime2(3)</FONT></TD></TR></TABLE>>];
  dw_DimDate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#4a8a3a" ALIGN="LEFT"><FONT COLOR="white"><B>dw.DimDate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">DateKey</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#998855" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">Date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">date</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Year / Month / Day</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">smallint, tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">IsoWeek / DayOfWeek</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">IsWeekend</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bit</FONT></TD></TR></TABLE>>];
  match_MatchCache [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8895a3"><TR><TD COLSPAN="3" BGCOLOR="#6a4fb3" ALIGN="LEFT"><FONT COLOR="white"><B>match.MatchCache</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#bb3333" POINT-SIZE="8"><B>PK</B></FONT></TD><TD ALIGN="LEFT">MatchCacheId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#998855" POINT-SIZE="8"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">InputHash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">binary(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">PromptVersion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">NormTitle / NormAuthor</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">CandidateBookIds</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Decision</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#3366cc" POINT-SIZE="8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">ResolvedBookId</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int NULL</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Confidence</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">decimal(4,3)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Model</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">varchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">Input/OutputTokens</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">HitCount</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="8">int</FONT></TD></TR></TABLE>>];
  { rank=same; ingest_Source; dw_Book; dw_DimDate; }
  { rank=same; ingest_ScrapeRun; dw_Listing; match_MatchCache; }
  { rank=same; ingest_StagingListing; dw_PriceSnapshot; }
  ingest_Source -> ingest_ScrapeRun;
  ingest_ScrapeRun -> ingest_StagingListing;
  ingest_Source -> dw_Listing;
  dw_Book -> dw_Listing;
  dw_Listing -> dw_PriceSnapshot;
  ingest_ScrapeRun -> dw_PriceSnapshot;
  dw_DimDate -> dw_PriceSnapshot;
  dw_Book -> dw_PriceSnapshot;
  dw_Book -> match_MatchCache;
}